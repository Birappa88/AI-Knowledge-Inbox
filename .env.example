# Required for real embeddings + answers.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. If true (or if OPENAI_API_KEY is missing), uses deterministic
# local embeddings and extractive answers so the app still runs offline.
MOCK_AI=false

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

PORT=3001
LOG_LEVEL=info
DATABASE_PATH=./data/inbox.db
